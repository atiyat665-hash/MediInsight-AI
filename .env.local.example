# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# Required: Google Gemini API key (used for analysis and chat)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional: OpenAI API key (used only for text-to-speech voice feature)
# If you do not need voice/TTS, you can leave this blank.
OPENAI_API_KEY=your_openai_key_here

# Required for "Email me this report": Resend API key
# Get one at https://resend.com/api-keys
RESEND_API_KEY=your_resend_key_here

# Optional: verified sender address for emails.
# Defaults to Resend's shared test sender (onboarding@resend.dev) if unset.
# Set this to a verified domain sender for production, e.g.
#   EMAIL_FROM="MediInsight AI <reports@yourdomain.com>"
EMAIL_FROM=

# Optional: max upload size in MB (default: 20)
MAX_FILE_SIZE_MB=20
